# ==============================================================================
# Animatto Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit actual secrets, private keys, or API tokens to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dodo Payments Configuration (Merchant of Record)
# ------------------------------------------------------------------------------
# Dodo environment mode: 'test_mode' (default) or 'live_mode'.
# In Phase 13/14, this MUST remain 'test_mode'.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_MODE=test

# Server-side API key issued from Dodo Payments Developer Dashboard.
# Test keys start with 'dodo_test_', live keys start with 'dodo_live_'.
# Keep blank for local mock sandbox development; set to test credentials for API calls.
DODO_PAYMENTS_API_KEY=dodo_test_replace_with_your_test_api_key

# Webhook signing key from Dodo Payments Dashboard -> Developer -> Webhooks.
# Webhook keys start with 'whsec_' followed by a base64 string.
DODO_PAYMENTS_WEBHOOK_KEY=whsec_replace_with_your_test_webhook_key
DODO_PAYMENTS_WEBHOOK_SECRET=whsec_replace_with_your_test_webhook_key

# Dodo Product IDs (Configurable allowlist)
# Tier 1: Animatto Lifetime Pro ($3.99 USD one-time purchase)
DODO_PAYMENTS_PRO_PRODUCT_ID=pdt_animatto_pro_lifetime

# Tier 2: Animatto Founder Supporter ($5.99 USD one-time purchase)
DODO_PAYMENTS_FOUNDER_PRODUCT_ID=pdt_animatto_founder_lifetime

# Live payments safety gate (Must remain false until official production launch)
ENABLE_PRODUCTION_PAYMENTS=false

# ------------------------------------------------------------------------------
# 2. Cryptographic License Signing (Ed25519)
# ------------------------------------------------------------------------------
# 32-byte Ed25519 private key seed in Base64 (RFC 8410).
# Used exclusively server-side by /api/webhook to cryptographically sign license tokens.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LICENSE_SIGNING_PRIVATE_KEY=replace_with_base64_32byte_ed25519_private_seed

# Matching 32-byte Ed25519 public key in Base64 for verification.
# (The official Animatto public key is hardcoded in the native macOS app client).
LICENSE_VERIFICATION_PUBLIC_KEY=THicWCQTcrv96L6uwREk9qLrOiQcz5aGnVgbG7QXMGE=

# ------------------------------------------------------------------------------
# 3. Persistent Database (PostgreSQL)
# ------------------------------------------------------------------------------
# ACID persistent storage connection string (PostgreSQL, Neon, Supabase, Vercel Postgres).
# In test mode without DATABASE_URL, an in-memory transactional store is used.
# In live production mode, a valid database connection string is STRICTLY REQUIRED.
DATABASE_URL=postgresql://user:password@localhost:5432/animatto
POSTGRES_URL=postgresql://user:password@localhost:5432/animatto

# ------------------------------------------------------------------------------
# 4. Transactional Email Delivery (Resend HTTPS API)
# ------------------------------------------------------------------------------
# Resend API key for license token delivery and self-service license recovery.
# API keys start with 're_'.
RESEND_API_KEY=re_replace_with_your_resend_api_key

# Sender email address with verified domain in Resend
EMAIL_FROM="Animatto Licensing <licensing@animatto.app>"

# ------------------------------------------------------------------------------
# 5. Public Application URLs
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://animatto.app
